<?php
/**
 * @file
 * Install, update, and uninstall functions for the Fancy Node Titles module.
 */

/**
 * Implements hook_schema().
 */
function fancy_node_titles_schema() {
  $schema['fancy_node_titles_display'] = array(
    'description' => 'Stores optional display title overrides for nodes.',
    'fields' => array(
      'nid' => array(
        'description' => 'The node ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'display_title' => array(
        'description' => 'The display title override. May contain allowed HTML.',
        'type' => 'varchar',
        'length' => 512,
        'not null' => FALSE,
        'default' => '',
      ),
      'icon' => array(
        'description' => 'Phosphor icon name to display before the title.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
        'default' => '',
      ),
    ),
    'primary key' => array('nid'),
  );
  return $schema;
}

/**
 * Implements hook_install().
 */
function fancy_node_titles_install() {
  // Migrate data from html_title module if it exists.
  if (db_table_exists('html_title_display')) {
    // Drop the table that hook_schema() just created, then rename the old one.
    db_drop_table('fancy_node_titles_display');
    db_rename_table('html_title_display', 'fancy_node_titles_display');

    // Add the icon column if the renamed table lacks it.
    if (!db_field_exists('fancy_node_titles_display', 'icon')) {
      db_add_field('fancy_node_titles_display', 'icon', array(
        'description' => 'Phosphor icon name to display before the title.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
        'default' => '',
      ));
    }
  }

  // Migrate config from html_title module if it exists.
  $old_config = config('html_title.settings');
  if ($old_config->get('enabled_types') !== NULL) {
    $new_config = config('fancy_node_titles.settings');
    $new_config->setData($old_config->getData());
    $new_config->save();
    $old_config->delete();
  }
}

/**
 * Implements hook_uninstall().
 */
function fancy_node_titles_uninstall() {
  config('fancy_node_titles.settings')->delete();
}

/**
 * Add icon column to fancy_node_titles_display table.
 */
function fancy_node_titles_update_1000() {
  if (!db_field_exists('fancy_node_titles_display', 'icon')) {
    db_add_field('fancy_node_titles_display', 'icon', array(
      'description' => 'Phosphor icon name to display before the title.',
      'type' => 'varchar',
      'length' => 128,
      'not null' => FALSE,
      'default' => '',
    ));
  }
}
